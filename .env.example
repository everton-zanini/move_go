# Postgres local (docker compose up -d db)
DATABASE_URL="postgresql://movepet:movepet@localhost:5432/move_pet?schema=public"
# Localmente não há pooler, então DIRECT_URL pode ser igual a DATABASE_URL.
# Na Vercel com Prisma Postgres, a integração já injeta os dois valores corretos
# (DATABASE_URL pooled + DIRECT_URL direta) automaticamente.
DIRECT_URL="postgresql://movepet:movepet@localhost:5432/move_pet?schema=public"

# Auth.js — gerar com: npx auth secret (ou: openssl rand -base64 32)
AUTH_SECRET="troque-por-um-valor-aleatorio-e-secreto"
NEXTAUTH_URL="http://localhost:3000"

# URL pública usada para montar os links de check-in dos QR Codes
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Super-admin da plataforma (gestão de igrejas em /platform) — criado pelo seed
SUPER_ADMIN_EMAIL="superadmin@movego.app"
SUPER_ADMIN_PASSWORD="troque-esta-senha"
