// MoveGO — schema completo (Fase 1)
// Todos os models de todas as fases já existem aqui para evitar migrations
// fragmentadas; a LÓGICA de cada área só é implementada na fase correspondente.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // DATABASE_URL: conexão pooled (usada em runtime pelo Prisma Client).
  // DIRECT_URL: conexão direta (usada pelo Prisma CLI para migrations/introspection —
  // obrigatória com Prisma Postgres da Vercel, que serve DATABASE_URL via pooler).
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// Auth.js (Prisma Adapter) — Fase 2
// ============================================================

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          Role      @default(USER)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  pet              Pet?
  checkIns         CheckIn[]
  userItems        UserItem[]
  userAchievements UserAchievement[]
  accounts         Account[]
  sessions         Session[]
}

// Exigidas pelo @auth/prisma-adapter mesmo com strategy "jwt".
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// Pet / Evolução — Fase 3
// ============================================================

model PetSpecies {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  evolutions PetEvolution[]
  pets       Pet[]
}

model PetEvolution {
  id            String   @id @default(cuid())
  speciesId     String
  levelRequired Int
  name          String // nome do estágio (ex.: "Spark", "Rise")
  sprite        String // chave de emoji/estilo hoje; path de spritesheet no futuro
  createdAt     DateTime @default(now())

  species PetSpecies @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  pets    Pet[]       @relation("CurrentEvolution")

  @@unique([speciesId, levelRequired])
  @@index([speciesId])
}

model Pet {
  id                 String    @id @default(cuid())
  userId             String    @unique
  speciesId          String
  currentEvolutionId String?
  nickname           String?
  level              Int       @default(1)
  totalXp            Int       @default(0)
  energy             Int       @default(100)
  happiness          Int       @default(100)
  currentStreak      Int       @default(0)
  longestStreak      Int       @default(0)
  lastCheckInAt      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  species          PetSpecies    @relation(fields: [speciesId], references: [id])
  currentEvolution PetEvolution? @relation("CurrentEvolution", fields: [currentEvolutionId], references: [id])

  @@index([speciesId])
}

// ============================================================
// Eventos / Check-in — Fase 4 e 5
// ============================================================

model Event {
  id            String   @id @default(cuid())
  name          String
  description   String?
  date          DateTime
  startTime     DateTime
  endTime       DateTime
  xpReward      Int
  qrCodeToken   String   @unique
  active        Boolean  @default(true)
  specialItemId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  specialItem Item?     @relation(fields: [specialItemId], references: [id])
  checkIns    CheckIn[]

  @@index([active, date])
}

model CheckIn {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  xpEarned  Int
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Idempotência: no máximo 1 check-in por usuário por evento — nunca ganha XP 2x.
  @@unique([userId, eventId])
  @@index([eventId])
  @@index([userId])
}

// ============================================================
// Itens / Inventário — Fase 6
// ============================================================

enum ItemSlot {
  HAT
  BACKGROUND
  ACCESSORY
  FRAME
  OTHER
}

model Item {
  id                 String   @id @default(cuid())
  name               String
  description        String?
  sprite             String
  slot               ItemSlot @default(OTHER)
  unlockLevel        Int?
  unlockCheckInCount Int?
  createdAt          DateTime @default(now())

  events    Event[]
  userItems UserItem[]
}

model UserItem {
  id         String   @id @default(cuid())
  userId     String
  itemId     String
  equipped   Boolean  @default(false)
  unlockedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId])
}

// ============================================================
// Conquistas — Fase 6
// ============================================================

enum AchievementCriteriaType {
  CHECKIN_COUNT
  STREAK
  LEVEL
  SPECIAL_EVENT
}

model Achievement {
  id            String                  @id @default(cuid())
  name          String
  description   String?
  icon          String
  criteriaType  AchievementCriteriaType
  criteriaValue Int?
  createdAt     DateTime                @default(now())

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
}

// ============================================================
// Configuração versionável do jogo — evita hardcode espalhado
// ============================================================

model ConfigEntry {
  key         String   @id
  value       String // JSON.stringify do valor (number/string/object)
  description String?
  updatedAt   DateTime @updatedAt
}
